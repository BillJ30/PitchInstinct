"""
PitchInstinct: UI system  ·  "Liquid Glass" over a tactical-board identity

Brief: render the interface in Apple-style Liquid Glass, translucent, frosted,
light-refracting surfaces that float above the content, while keeping the
tactical-board identity underneath (Saira Condensed/Inter type, chalk-line section
headers, floodlit palette, FUT cards).

How the glass is built (the convincing-glass checklist):
  • Frost:      backdrop-filter: blur() saturate() on every surface, so the
                 colourful ambient backdrop blurs and the colours bloom through.
  • Specular:   a bright inset top rim + a diagonal sheen highlight on each
                 pane: the single cue that reads as "glass" rather than "blur".
  • Depth:      layered translucency (sidebar deepest/most opaque, cards mid,
                 highlights topmost) and soft, large floating shadows.
  • Refraction: a vivid ambient colour mesh sits BEHIND the glass so there's
                 something to bend; without it frosted panels look grey.
  • Liquid:     generous radii, pill-shaped controls, a slow ambient drift
                 (disabled under prefers-reduced-motion).

Public API unchanged (hero, section, stat_card, rec_box, form_pills, attr_bar,
fut_card, legend, how_to_row, live_badge) so pages need no edits.
"""

import re
import streamlit as st

# ── palette (dark frosted glass over photo · teal accent · white text) ────────
SKY    = "#19C4AC"   # teal primary (bright on dark)
SKY_HI = "#5FE0CE"
CYAN   = "#34D9C2"   # mint secondary
GOLD   = "#5FE0CE"   # (legacy name) → mint
GREEN  = "#36D17F"
AMBER  = "#FFB845"
RED    = "#FF6B7D"

BASE   = "#0B1322"
PANEL  = "rgba(16,26,44,0.55)"
PANEL2 = "rgba(16,26,44,0.45)"
INK    = "#0B1322"
NAVY   = "#0B1322"
NAVY2  = "#10203A"
CARD   = "rgba(15,24,42,0.52)"
LINE   = "rgba(255,255,255,0.12)"
HAIR   = "rgba(255,255,255,0.10)"
TXT    = "#F2F6FC"
MUT    = "#B4C2D6"

# accent gradient (teal → mint)
ACCENT_GRAD = "linear-gradient(135deg, #19C4AC 0%, #5FE0CE 100%)"

# glass tokens (dark frosted surfaces so white text reads over the photo)
GLASS_BG   = "linear-gradient(135deg, rgba(44,64,96,0.36) 0%, rgba(16,28,50,0.44) 46%, rgba(11,20,40,0.52) 100%)"
GLASS_RIM  = "rgba(255,255,255,0.15)"
GLASS_BLUR = "blur(26px) saturate(160%)"
GLASS_SHADOW = "0 18px 46px -18px rgba(0,0,0,0.6), 0 2px 10px -6px rgba(0,0,0,0.45)"
GLASS_INSET  = "inset 0 1px 0 rgba(255,255,255,0.28), inset 0 0 0 1px rgba(255,255,255,0.05), inset 0 -16px 30px -22px rgba(0,0,0,0.40)"
SHEEN = "linear-gradient(133deg, rgba(255,255,255,0.18) 0%, rgba(255,255,255,0.06) 18%, transparent 42%)"


def inject_theme():
    st.markdown(f"""
    <style>
    @import url('https://fonts.googleapis.com/css2?family=Saira+Condensed:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap');

    :root {{ --sky:{SKY}; --gold:{GOLD}; --cyan:{CYAN}; --green:{GREEN}; --red:{RED}; --amber:{AMBER};
             --glass-blur:{GLASS_BLUR};
             --font:-apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Inter", system-ui, sans-serif; }}

    /* ============================ base + ambient mesh ============================ */
    /* vivid, soft colour blobs behind everything so the glass has colour to refract */
    [data-testid="stAppViewContainer"]{{
        background:
          radial-gradient(1100px 640px at 84% -12%, rgba(84,182,242,0.22), transparent 60%),
          radial-gradient(880px 560px at 4% 2%, rgba(55,224,206,0.13), transparent 58%),
          radial-gradient(900px 600px at 14% 112%, rgba(96,132,236,0.16), transparent 60%),
          linear-gradient(168deg, #EEF2F6 0%, #E9EEF3 55%, #E4EAF0 100%);
        background-attachment: fixed;
    }}
    /* slow-drifting glow mesh for depth + the "liquid" feel */
    [data-testid="stAppViewContainer"]::before{{
        content:""; position:fixed; inset:-20%; z-index:0; pointer-events:none; opacity:.5;
        background:
          radial-gradient(480px 420px at 26% 34%, rgba(47,203,182,0.14), transparent 60%),
          radial-gradient(460px 400px at 76% 64%, rgba(90,215,196,0.12), transparent 60%),
          radial-gradient(420px 360px at 54% 16%, rgba(21,179,160,0.08), transparent 60%);
        animation: drift 28s ease-in-out infinite alternate;
    }}
    @keyframes drift {{ from{{ transform:translate3d(-3%,-2%,0) scale(1); }}
                        to{{ transform:translate3d(3%,3%,0) scale(1.08); }} }}
    .main .block-container, [data-testid="stSidebar"] > div{{ position:relative; z-index:1; }}
    [data-testid="stHeader"]{{ background:transparent; }}
    .block-container{{ padding-top:2.0rem; max-width:1280px; }}

    html, body, [class*="css"]{{ font-family:var(--font); color:{TXT}; }}
    p, span, label, li, .stMarkdown{{ color:{TXT}; }}
    h1,h2,h3,h4{{ font-family:var(--font) !important; color:#F2F6FC !important;
        letter-spacing:.4px; font-weight:600; }}
    .os{{ font-family:var(--font); font-feature-settings:'tnum' 1; }}
    /* text that sits directly on the dark photo backdrop stays light */
    [data-testid="stCaptionContainer"], [data-testid="stWidgetLabel"], [data-testid="stWidgetLabel"] p{{ color:#B7C3D4 !important; }}

    @keyframes rise {{ from{{opacity:0; transform:translateY(10px);}} to{{opacity:1; transform:none;}} }}
    @keyframes blink {{ 0%,100%{{opacity:1;}} 50%{{opacity:.35;}} }}
    .block-container > div{{ animation:rise .42s cubic-bezier(.2,.7,.3,1) both; }}
    @media (prefers-reduced-motion: reduce){{
        .block-container > div{{ animation:none; }}
        [data-testid="stAppViewContainer"]::before{{ animation:none; }}
        .live-dot{{ animation:none !important; }}
        .hero-live::after{{ animation:none !important; }}
    }}

    /* ============================ sidebar (deepest glass layer) ============================ */
    [data-testid="stSidebar"]{{
        background:linear-gradient(180deg, rgba(8,16,32,0.72), rgba(10,23,48,0.66));
        backdrop-filter:{GLASS_BLUR}; -webkit-backdrop-filter:{GLASS_BLUR};
        border-right:1px solid {GLASS_RIM};
        box-shadow:inset -1px 0 0 rgba(255,255,255,0.04);
    }}
    [data-testid="stSidebar"] .block-container{{ padding-top:1.2rem; }}
    .brand{{ font-family:var(--font); font-weight:700; font-size:1.24rem; color:#EAF1F8;
        letter-spacing:.3px; text-transform:uppercase; line-height:1.05; white-space:nowrap; }}
    .brand span{{ color:{SKY}; }}
    .navlabel{{ font-family:var(--font); font-size:.72rem; letter-spacing:2.5px;
        text-transform:uppercase; color:{MUT}; margin:10px 0 4px; }}
    /* flat, minimal nav — no boxes, tight spacing (Finder-like) */
    [data-testid="stSidebar"] [data-testid="stExpander"]{{
        border:none !important; background:transparent !important; box-shadow:none !important; margin-bottom:0 !important; }}
    [data-testid="stSidebar"] [data-testid="stExpander"] details,
    [data-testid="stSidebar"] [data-testid="stExpander"] details > summary{{
        border:none !important; background:transparent !important; box-shadow:none !important; }}
    [data-testid="stSidebar"] [data-testid="stExpander"] summary{{
        font-family:var(--font); letter-spacing:.3px; text-transform:none;
        font-size:.92rem; font-weight:600; color:#E6EEF9; padding:5px 6px; border-radius:8px;
        transition:background .14s ease; }}
    [data-testid="stSidebar"] [data-testid="stExpander"] summary:hover{{
        color:#F2F6FC; background:rgba(255,255,255,.05); }}
    [data-testid="stSidebar"] [data-testid="stVerticalBlock"]{{ gap:.25rem !important; }}
    [data-testid="stSidebar"] .stButton button{{
        background:transparent; border:none; border-radius:8px;
        color:{MUT}; font-family:var(--font); font-weight:500; font-size:.9rem;
        text-align:left; justify-content:flex-start; padding:3px 12px; min-height:0;
        transition:background .12s ease, color .12s ease; }}
    [data-testid="stSidebar"] .stButton button:hover{{
        background:rgba(255,255,255,.05); color:#F2F6FC; }}
    /* active page (minimal accent fill, no marker) */
    [data-testid="stSidebar"] .stButton button[kind="primary"],
    [data-testid="stSidebar"] .stButton button[data-testid="baseButton-primary"]{{
        background:rgba(90,176,236,.18) !important; color:{SKY_HI} !important; border:none !important;
        font-weight:600; box-shadow:none !important; }}
    [data-testid="stSidebar"] .stButton button[kind="primary"]:hover,
    [data-testid="stSidebar"] .stButton button[data-testid="baseButton-primary"]:hover{{
        background:rgba(90,176,236,.26) !important; color:#F2F6FC !important; }}

    /* ============================ Safari-style top tab bar ============================ */
    /* nav strip: one row that scrolls left/right (only blocks that contain buttons) */
    [data-testid="stAppViewContainer"] [data-testid="stHorizontalBlock"]:has(.stButton){{
        flex-wrap:nowrap !important; overflow-x:auto; overflow-y:hidden; gap:4px; padding-bottom:6px;
        scrollbar-width:thin; scrollbar-color:rgba(255,255,255,.18) transparent; }}
    [data-testid="stAppViewContainer"] [data-testid="stHorizontalBlock"]:has(.stButton) > [data-testid="stColumn"]{{
        flex:0 0 auto !important; width:auto !important; min-width:max-content; }}
    [data-testid="stAppViewContainer"] [data-testid="stHorizontalBlock"]:has(.stButton)::-webkit-scrollbar{{ height:7px; }}
    [data-testid="stAppViewContainer"] [data-testid="stHorizontalBlock"]:has(.stButton)::-webkit-scrollbar-thumb{{
        background:rgba(255,255,255,.16); border-radius:10px; }}
    [data-testid="stAppViewContainer"] .stButton>button{{ border-radius:9px; font-family:var(--font); white-space:nowrap;
        text-transform:none; letter-spacing:0; font-size:.88rem; font-weight:500; padding:6px 12px;
        min-height:0; line-height:1.2; background:transparent; border:1px solid transparent;
        color:#E9EFF8; font-weight:600; transition:all .14s ease; box-shadow:none; }}
    [data-testid="stAppViewContainer"] .stButton>button:hover{{ background:rgba(255,255,255,.07); color:#F2F6FC; }}
    [data-testid="stAppViewContainer"] .stButton>button[kind="primary"],
    [data-testid="stAppViewContainer"] .stButton>button[data-testid="baseButton-primary"]{{
        background:linear-gradient(135deg, rgba(21,179,160,.20), rgba(90,215,196,.15)) !important;
        color:#FFFFFF !important; border:1px solid rgba(21,179,160,.45) !important;
        box-shadow:0 6px 18px -8px rgba(55,160,230,.55), inset 0 1px 0 rgba(255,255,255,.16) !important; }}
    [data-testid="stAppViewContainer"] .stButton>button[kind="primary"]:hover,
    [data-testid="stAppViewContainer"] .stButton>button[data-testid="baseButton-primary"]:hover{{
        background:linear-gradient(135deg, rgba(21,179,160,.30), rgba(90,215,196,.22)) !important; color:#FFFFFF !important; }}

    /* search popover trigger (header icon) + suggestions */
    [data-testid="stPopover"] button{{ width:auto !important; height:42px !important; border-radius:12px !important;
        padding:0 12px !important; min-height:0 !important; background:rgba(255,255,255,.62) !important;
        -webkit-backdrop-filter:{GLASS_BLUR}; backdrop-filter:{GLASS_BLUR};
        border:1px solid {GLASS_RIM} !important; color:{TXT} !important;
        box-shadow:0 6px 18px -10px rgba(0,0,0,.6) !important; }}
    [data-testid="stPopover"] button:hover{{ border-color:rgba(21,179,160,.5) !important; background:rgba(255,255,255,.82) !important; }}
    [data-testid="stPopover"] button [data-testid="stIconMaterial"]{{ font-size:1.25rem !important; margin:0 !important; }}
    [data-testid="stPopoverBody"]{{ min-width:300px; }}
    .search-sugg-label{{ font-size:.64rem; letter-spacing:2px; text-transform:uppercase; color:{MUT}; margin:2px 0 8px 2px; font-weight:600; }}

    /* ============================ hero (signature glass pane) ============================ */
    .hero{{
        position:relative; border-radius:22px; padding:24px 28px 22px; margin-bottom:22px;
        background:{GLASS_BG};
        backdrop-filter:{GLASS_BLUR}; -webkit-backdrop-filter:{GLASS_BLUR};
        border:1px solid {GLASS_RIM}; overflow:hidden;
        box-shadow:{GLASS_SHADOW}, {GLASS_INSET};
    }}
    /* layer 1: diagonal sheen + faint pitch markings (centre line + circle) */
    .hero::before{{ content:""; position:absolute; inset:0; pointer-events:none;
        background:
          {SHEEN},
          radial-gradient(circle at 88% 46%, transparent 53px, rgba(180,214,245,.16) 54px, transparent 55px),
          linear-gradient(90deg, transparent calc(88% - .5px), rgba(180,214,245,.16) 88%, transparent calc(88% + .5px));
    }}
    /* matchday sweep: a slow broadcast-style highlight pass across the hero band */
    .hero-live{{ border-color:rgba(108,171,221,0.38); }}
    .hero-live::after{{ content:""; position:absolute; inset:0; pointer-events:none; z-index:0;
        background:linear-gradient(100deg, transparent 30%, rgba(108,171,221,0.22) 46%,
          rgba(91,233,214,0.16) 52%, transparent 68%);
        background-size:240% 100%; background-position:120% 0;
        animation:heroSweep 7s ease-in-out infinite; }}
    @keyframes heroSweep{{ 0%{{background-position:130% 0;}} 50%{{background-position:-30% 0;}} 100%{{background-position:130% 0;}} }}
    .hero .eyebrow{{ display:flex; align-items:center; gap:10px; margin-bottom:8px; position:relative; z-index:1; }}
    .hero .eyebrow .tick{{ width:28px; height:2px; background:{ACCENT_GRAD}; box-shadow:0 0 12px rgba(84,182,242,.8); }}
    .hero .eyebrow span{{ font-family:var(--font); font-size:.72rem; letter-spacing:3px;
        text-transform:uppercase; color:{SKY_HI}; }}
    .hero h1{{ margin:0; font-size:2.05rem; font-weight:700; color:#F2F6FC !important;
        text-transform:uppercase; letter-spacing:.6px; line-height:1.02; font-family:var(--font); position:relative; z-index:1; }}
    .hero p{{ margin:7px 0 0; color:#C8DAF4; font-size:.98rem; max-width:70ch; position:relative; z-index:1; }}

    /* ============================ chalk section header ============================ */
    .sec{{ display:flex; align-items:baseline; gap:12px; margin:26px 0 14px; position:relative; }}
    .sec h3{{ margin:0; font-size:1.04rem; text-transform:uppercase; letter-spacing:2px;
        color:#EAF1F8 !important; white-space:nowrap; font-weight:600; }}
    .sec .rule{{ flex:1; height:1px; background:linear-gradient(90deg, {CYAN} 0, {SKY} 24px, {HAIR} 70px, {HAIR} 100%); position:relative; }}
    .sec .rule::before{{ content:""; position:absolute; left:0; top:-4px; width:3px; height:11px; border-radius:2px; background:{ACCENT_GRAD}; }}

    /* ============================ STAT STRIP (glass) ============================ */
    div[data-testid="stHorizontalBlock"]:has(> div [data-sc]) {{
        background:{GLASS_BG};
        backdrop-filter:{GLASS_BLUR}; -webkit-backdrop-filter:{GLASS_BLUR};
        border:1px solid {GLASS_RIM}; border-radius:16px; padding:4px 2px; gap:0 !important;
        box-shadow:{GLASS_SHADOW}, {GLASS_INSET}; position:relative; overflow:hidden;
    }}
    div[data-testid="stHorizontalBlock"]:has(> div [data-sc])::before{{
        content:""; position:absolute; inset:0; pointer-events:none; background:{SHEEN}; }}
    div[data-testid="stHorizontalBlock"]:has(> div [data-sc]) > div[data-testid="stColumn"]{{
        border-right:1px solid rgba(255,255,255,0.07); }}
    div[data-testid="stHorizontalBlock"]:has(> div [data-sc]) > div[data-testid="stColumn"]:last-child{{
        border-right:none; }}
    .sc{{ text-align:center; padding:14px 10px 13px; position:relative; z-index:1; }}
    .sc .v{{ font-family:var(--font); font-feature-settings:'tnum' 1; font-size:2.05rem;
        font-weight:600; color:#F2F6FC; line-height:1; letter-spacing:.5px;
        text-shadow:0 1px 10px rgba(120,180,230,.25); }}
    .sc .l{{ font-family:var(--font); font-size:.68rem; letter-spacing:2px; text-transform:uppercase;
        color:{MUT}; margin-top:8px; font-weight:500; }}
    .sc .s{{ font-size:.7rem; color:{SKY}; margin-top:4px; font-family:var(--font); }}
    .sc.good .v{{ color:{GREEN}; }} .sc.warn .v{{ color:{AMBER}; }}
    .sc.risk .v{{ color:{RED}; }}  .sc.peak .v{{ color:{GOLD}; }} .sc.live .v{{ color:{CYAN}; }}

    /* standalone tile = its own glass pane */
    .tile{{ position:relative; overflow:hidden; background:{GLASS_BG};
        backdrop-filter:{GLASS_BLUR}; -webkit-backdrop-filter:{GLASS_BLUR};
        border:1px solid {GLASS_RIM}; border-radius:16px; padding:15px 12px; text-align:center;
        box-shadow:{GLASS_SHADOW}, {GLASS_INSET}; }}
    .tile::before{{ content:""; position:absolute; inset:0; pointer-events:none; background:{SHEEN}; }}
    .tile .v{{ font-family:var(--font); font-feature-settings:'tnum' 1; font-size:2rem; font-weight:600;
        color:#F2F6FC; line-height:1; position:relative; z-index:1; }}
    .tile .l{{ font-family:var(--font); font-size:.68rem; letter-spacing:2px; text-transform:uppercase; color:{MUT};
        margin-top:7px; position:relative; z-index:1; }}

    /* ============================ EA-style verdict cards ============================ */
    .verdict{{ position:relative; overflow:hidden; border-radius:18px; padding:18px 18px 16px; min-height:118px;
        display:flex; flex-direction:column; justify-content:space-between;
        border:1px solid {GLASS_RIM}; backdrop-filter:{GLASS_BLUR}; -webkit-backdrop-filter:{GLASS_BLUR};
        box-shadow:{GLASS_SHADOW}; }}
    .verdict::before{{ content:""; position:absolute; inset:0; pointer-events:none; background:{SHEEN}; }}
    .verdict .vd-l{{ font-family:var(--font); font-size:.7rem; letter-spacing:2px; text-transform:uppercase;
        color:rgba(255,255,255,.78); font-weight:600; position:relative; z-index:1; }}
    .verdict .vd-v{{ font-family:var(--font); font-size:1.7rem; font-weight:700; color:#FFFFFF; line-height:1;
        text-transform:uppercase; letter-spacing:.5px; text-shadow:0 2px 10px rgba(0,0,0,.4); position:relative; z-index:1; }}

    /* ============================ glass cards ============================ */
    .card{{ position:relative; overflow:hidden; background:{GLASS_BG};
        backdrop-filter:{GLASS_BLUR}; -webkit-backdrop-filter:{GLASS_BLUR};
        border:1px solid {GLASS_RIM}; border-radius:16px; padding:16px 18px; margin-bottom:12px;
        box-shadow:{GLASS_SHADOW}, {GLASS_INSET};
        transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease; }}
    .card::before{{ content:""; position:absolute; inset:0; pointer-events:none; background:{SHEEN}; }}
    .card:hover{{ transform:translateY(-2px); border-color:rgba(180,214,245,0.28);
        box-shadow:0 18px 48px -18px rgba(0,0,0,.7), {GLASS_INSET}; }}
    .card > *{{ position:relative; z-index:1; }}

    /* ============================ readout (rec_box) glass ============================ */
    .rec{{ position:relative; overflow:hidden; border-radius:12px; padding:12px 16px 12px 18px; margin:9px 0;
        background:linear-gradient(135deg, rgba(120,180,230,0.10), rgba(14,27,51,0.34));
        backdrop-filter:{GLASS_BLUR}; -webkit-backdrop-filter:{GLASS_BLUR};
        border:1px solid {GLASS_RIM}; border-left:3px solid {SKY};
        box-shadow:0 8px 26px -16px rgba(0,0,0,.6), inset 0 1px 0 rgba(255,255,255,0.16);
        font-size:.95rem; line-height:1.55; color:#DCEAFB; }}
    .rec::before{{ content:""; position:absolute; inset:0; pointer-events:none; background:{SHEEN}; }}
    .rec > *{{ position:relative; z-index:1; }}
    .rec .kick{{ font-family:var(--font); font-size:.64rem; letter-spacing:2px; text-transform:uppercase;
        display:block; margin-bottom:3px; color:{SKY}; position:relative; z-index:1; }}
    .rec b{{ color:{SKY_HI}; font-weight:600; }}
    .rec-good{{ border-left-color:{GREEN}; }} .rec-good .kick{{ color:{GREEN}; }}
    .rec-warn{{ border-left-color:{AMBER}; }} .rec-warn .kick{{ color:{AMBER}; }}
    .rec-info{{ border-left-color:{SKY}; }}

    /* ============================ pills (glass) ============================ */
    .pill{{ display:inline-flex; align-items:center; justify-content:center; min-width:26px;
        height:26px; padding:0 9px; border-radius:30px; font-size:.78rem; font-weight:600;
        margin:2px; font-family:var(--font); letter-spacing:.5px;
        backdrop-filter:blur(6px); -webkit-backdrop-filter:blur(6px);
        box-shadow:inset 0 1px 0 rgba(255,255,255,0.18); }}
    .pw{{ background:rgba(63,215,126,.18); color:{GREEN}; border:1px solid rgba(63,215,126,.5); }}
    .pd{{ background:rgba(255,192,77,.16); color:{AMBER}; border:1px solid rgba(255,192,77,.46); }}
    .pl{{ background:rgba(255,93,108,.16); color:{RED};   border:1px solid rgba(255,93,108,.46); }}

    .live-dot{{ display:inline-block; width:8px; height:8px; border-radius:50%; background:{CYAN};
        box-shadow:0 0 10px {CYAN}; margin-right:7px; animation:blink 1.6s infinite; }}

    /* ============================ news ticker (broadcast-style scroller) ============================ */
    .ticker-wrap{{ position:relative; overflow:hidden; border-radius:12px; padding:10px 0;
        background:linear-gradient(135deg, rgba(47,203,182,0.14), rgba(255,255,255,0.50));
        backdrop-filter:{GLASS_BLUR}; -webkit-backdrop-filter:{GLASS_BLUR};
        border:1px solid {GLASS_RIM}; box-shadow:{GLASS_SHADOW}; display:flex; align-items:center; }}
    .ticker-tag{{ flex:0 0 auto; display:flex; align-items:center; gap:6px; padding:0 16px;
        border-right:1px solid {GLASS_RIM}; font-family:var(--font); font-size:.72rem; letter-spacing:2px;
        text-transform:uppercase; color:#5FE0CE; white-space:nowrap; position:relative; z-index:2;
        background:rgba(255,255,255,0.62); }}
    .ticker-viewport{{ flex:1 1 auto; overflow:hidden; position:relative; }}
    .ticker-track{{ display:flex; flex-shrink:0; white-space:nowrap; width:max-content;
        animation:tickerScroll 32s linear infinite; }}
    .ticker-wrap:hover .ticker-track{{ animation-play-state:paused; }}
    .ticker-item{{ display:inline-flex; align-items:center; padding:0 30px; font-size:.88rem; color:{TXT}; }}
    .ticker-item b{{ color:{GOLD}; margin-right:8px; }}
    .ticker-item::after{{ content:"•"; color:{MUT}; margin-left:30px; }}
    @keyframes tickerScroll{{ from{{ transform:translateX(0); }} to{{ transform:translateX(-50%); }} }}
    @media (prefers-reduced-motion: reduce){{ .ticker-track{{ animation:none; }} }}

    /* ============================ FUT-style player card (frosted tint) ============================ */
    .fut{{ width:100%; border-radius:18px; padding:15px 16px 17px; position:relative;
        overflow:hidden; border:1px solid rgba(255,255,255,.20);
        backdrop-filter:blur(8px) saturate(140%); -webkit-backdrop-filter:blur(8px) saturate(140%);
        box-shadow:0 18px 40px -20px rgba(0,0,0,.8), inset 0 1px 0 rgba(255,255,255,0.28);
