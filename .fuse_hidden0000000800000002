def team_color(name):
    return TEAM_COLORS.get(name, SKY)

def _text_on(hexc):
    h = hexc.lstrip("#")
    if len(h) != 6:
        return "#FFFFFF"
    r, g, b = int(h[0:2],16), int(h[2:4],16), int(h[4:6],16)
    lum = (0.299*r + 0.587*g + 0.114*b) / 255
    return "#0A0F1C" if lum > 0.62 else "#FFFFFF"

def match_banner(home, away, label="Next Fixture", note=""):
    """Team-colour VS banner: home colours left, away right, VS medallion centre."""
    hc, ac = team_color(home), team_color(away)
    ht, at = _text_on(hc), _text_on(ac)
    grad = (f"linear-gradient(100deg, {hc} 0%, {hc} 40%, #0E1626 49%, "
            f"#0E1626 51%, {ac} 60%, {ac} 100%)")
    note_html = f'<div class="fx-note">{note}</div>' if note else ''
    st.markdown(f"""
    <style>
    .fixture{{ position:relative; border-radius:18px; padding:20px 30px 18px; margin:6px 0 18px;
        overflow:hidden; background:{grad};
        box-shadow:{GLASS_SHADOW}; border:1px solid {GLASS_RIM}; }}
    .fx-eyebrow{{ text-align:center; font-family:var(--font); letter-spacing:2px; text-transform:uppercase;
        font-size:.72rem; color:{MUT}; font-weight:700; }}
    .fx-row{{ display:flex; align-items:center; justify-content:space-between; gap:14px; margin:8px 0 2px; }}
    .fx-team{{ flex:1; font-family:var(--font); font-weight:700; font-size:2rem; line-height:1.05;
        text-transform:uppercase; letter-spacing:.5px; text-shadow:0 2px 10px rgba(0,0,0,.4); }}
    .fx-team-r{{ text-align:right; }}
    .fx-vs{{ flex:0 0 auto; font-family:var(--font); font-weight:700; font-size:1.05rem; color:#FFFFFF;
        background:#0E1626; border-radius:50%; width:54px; height:54px; display:flex;
        align-items:center; justify-content:center; box-shadow:0 6px 16px -4px rgba(0,0,0,.6);
        border:2px solid {SKY}; }}
    .fx-note{{ text-align:center; font-size:.78rem; color:{MUT}; margin-top:4px; font-weight:500;
        text-transform:uppercase; letter-spacing:1px; }}
    </style>
