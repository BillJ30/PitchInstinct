def glossary_box(glossary, keys):
    """Render a collapsed '📖 Glossary' dropdown defining the jargon used on this page.
    No-ops if `keys` is empty so it's safe to call unconditionally."""
    if not keys:
        return
    with st.expander("📖 Glossary, terms used on this page"):
        for k in keys:
            d = glossary.get(k)
            if not d:
                continue
            term, _, rest = d.partition(": ")
            st.markdown(f"**{term}:** {rest}" if rest else f"**{d}**")


_TICKER_ICONS = {"history": "", "live": ""}

def news_ticker(items, tag="Season Watch", as_of=None):
    """A broadcast-style scrolling strip. `items` is a list of (kind, text) pairs,
    kind being 'history' (a real dated storyline) or 'live' (computed from the
    current snapshot), each gets its own icon. The track is duplicated once so
    the loop is seamless; hovering pauses it."""
    if not items:
        return ""
    row = "".join(f'<span class="ticker-item">{_TICKER_ICONS.get(kind,"•")} {text}</span>' for kind, text in items)
    sub = f'<span style="opacity:.6;font-size:.66rem;margin-left:8px">AS OF {as_of}</span>' if as_of else ""
    return (f'<div class="ticker-wrap">'
            f'<div class="ticker-tag"><span class="live-dot"></span>{tag}{sub}</div>'
            f'<div class="ticker-viewport"><div class="ticker-track">{row}{row}</div></div></div>')


def live_badge(text="Live"):
